# Versioned API base path (API.md). In development Vite proxies it to
# http://localhost:8080; in production it is served by the backend.
VITE_API_BASE_URL=/api/v1

# Bearer token for /api/* (ADR-005).
# Vite inlines VITE_* values into the bundle at build time, so this value is
# visible to anyone who can load the app: use it for local development only and
# never commit a real token. Nothing is persisted to localStorage.
VITE_API_TOKEN=
