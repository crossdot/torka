APP_HOST=0.0.0.0
APP_PORT=8080
RUST_LOG=info

# Replace with a strong secret before use; never commit real secrets.
APP_API_TOKEN=change-me-before-use

SEARCH_TIMEOUT_SECS=8
SEARCH_MAX_PARALLEL=4
SEARCH_CACHE_TTL_SECS=60
SEARCH_CACHE_MAX_ENTRIES=200

PROVIDER_RUTRACKER_ENABLED=false
PROVIDER_RUTOR_ENABLED=false

MAX_ACTIVE_SESSIONS=2
SESSION_IDLE_TIMEOUT_SECS=900
TORRENT_RESOLVE_TIMEOUT_SECS=60
FFMPEG_START_TIMEOUT_SECS=30
MAX_TRANSCODE_SESSIONS=1

# Hardware acceleration (Intel VA-API). See STREAMING.md section 6.
HWACCEL_MODE=auto
VAAPI_DEVICE=/dev/dri/renderD128
HWACCEL_REQUIRED=false

# Startup/source buffering limits. See STREAMING.md sections 4.3, 11.1, 14.1.
STARTUP_BUFFER_SIZE_MB=100
SOURCE_CACHE_MAX_MB=512

# FFmpeg/FFprobe executables; default to PATH lookup.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

CACHE_DIR=/cache
SESSION_DIR=/cache/sessions
CACHE_MAX_BYTES=2147483648

# Optional metadata catalog (ADR-007, undecided).
METADATA_API_KEY=
