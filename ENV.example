APP_HOST=0.0.0.0
APP_PORT=8080
RUST_LOG=info

# Replace with a strong secret before use; never commit real secrets.
APP_API_TOKEN=change-me-before-use

SEARCH_TIMEOUT_SECS=8
SEARCH_MAX_PARALLEL=4
SEARCH_CACHE_TTL_SECS=60
SEARCH_CACHE_MAX_ENTRIES=200

# Per-IP rate limiting on /api/v1 (sliding window). 0 = disabled.
RATE_LIMIT_REQUESTS=300
RATE_LIMIT_WINDOW_SECS=60

PROVIDER_RUTRACKER_ENABLED=false
# RuTracker Atom feed: comma-separated base URLs (mirrors) + forum id.
PROVIDER_RUTRACKER_URLS=https://feed.rutracker.cc
PROVIDER_RUTRACKER_FORUM_ID=0
PROVIDER_RUTOR_ENABLED=false
# Rutor: comma-separated base URLs; the first reachable host is used.
PROVIDER_RUTOR_URLS=https://rutor.info,https://rutor.is
# Fake in-memory provider for local development/testing (no internet required).
PROVIDER_FAKE_ENABLED=false

MAX_ACTIVE_SESSIONS=2
SESSION_IDLE_TIMEOUT_SECS=900
TORRENT_RESOLVE_TIMEOUT_SECS=60
FFMPEG_START_TIMEOUT_SECS=30
MAX_TRANSCODE_SESSIONS=1

# Hardware acceleration (vendor-agnostic). See ADR-008 and STREAMING.md section 6.
# auto | software | vaapi (Intel iGPU / AMD) | nvenc (NVIDIA)
HWACCEL_MODE=auto
# Optional device node for the selected backend; empty = auto-detect.
HWACCEL_DEVICE=/dev/dri/renderD128
HWACCEL_REQUIRED=false

# Startup/source buffering limits. See STREAMING.md sections 4.3, 11.1, 14.1.
STARTUP_BUFFER_SIZE_MB=100
SOURCE_CACHE_MAX_MB=512

# FFmpeg/FFprobe executables; default to PATH lookup.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# How many seconds of HLS output to keep on disk (sliding window). Older segments
# are deleted by FFmpeg. Smaller = less disk, shorter backward seek without restart.
HLS_WINDOW_SECS=300

CACHE_DIR=/cache
SESSION_DIR=/cache/sessions
# Per-torrent in-memory streaming buffer (no file cache on disk). Old pieces past
# this budget are evicted (LRU); sets how far back seeking can re-buffer in-memory.
STREAM_BUFFER_BYTES=1073741824

# Optional metadata catalog (ADR-007, undecided).
METADATA_API_KEY=
